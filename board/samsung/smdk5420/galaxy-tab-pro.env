stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=part start mmc 0 USERDATA userdata_start; part size mmc 0 USERDATA userdata_size; blkmap create root; blkmap map root 0 0x${userdata_size} linear mmc 0 0x${userdata_start}
blkboot=setenv devtype blkmap; setenv devnum 0; run scan_dev_for_boot

bootdelay=0
bootcmd=run distro_bootcmd; run blkboot

bootmenu_0=Continue Boot=boot
bootmenu_1=Boot eMMC=run blkboot
bootmenu_2=Boot SD=run distro_bootcmd
bootmenu_3=Reboot=reset

button_cmd_0_name=Volume Down
button_cmd_0=bootmenu
